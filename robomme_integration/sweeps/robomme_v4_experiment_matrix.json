    "cfg_train_dropout": 0.2,
    "cfg_eval_scales": [0.5, 1.0, 1.5, 2.0],
    "gdn_history_dropout": [0.0, 0.2],
    "jepa": {
      "weight": 0.1,
      "futures": 1,
      "regularizer": "visreg",
      "visreg_weight": 0.05,
      "visreg_slices": 128,
      "visreg_components": {"scale": 1.0, "shape": 1.0, "center": 1.0}
    }
  },
